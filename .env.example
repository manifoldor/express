# 快递100（轨迹查询需要 KEY 与 CUSTOMER 同时配置；缺密钥会返回错误，不会编造轨迹）
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=

# 快递鸟（轨迹查询需要 API_KEY 与 E_BUSINESS_ID 同时配置）
KDNIAO_API_KEY=
KDNIAO_E_BUSINESS_ID=

# 默认物流查询引擎: auto | kuaidi100 | kdniao | simulator
EXPRESS_DEFAULT_PROVIDER=auto

# 设为 1 才返回标注为 DEMO DATA 的虚构轨迹。不要在查询真实包裹时打开
# EXPRESS_DEMO=1

# 本地监控与缓存目录 (默认: ~/.grokbot/express)
EXPRESS_DATA_DIR=
